<decryptionDataProviders:SecurityFileDecryptionDataProviderBase x:Class="SafeNotePad.Views.CryptoDataProviders.DecryptionDataProviders.SecurityFileDecryptionDataProvider"
                            x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:decryptionDataProviders="clr-namespace:SafeNotePad.Views.CryptoDataProviders.DecryptionDataProviders"
        xmlns:validation="clr-namespace:SafeNotePad.Views.Validation"
        Title="Authorize with Security File" SizeToContent="WidthAndHeight" Background="Beige" Icon="..\..\Images\lock-8-32.png" AllowDrop="True" Drop="File_Drop" >
    <Grid Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Image Grid.Row="0" Source="../../Images/access.png" Height="24" Width="340" HorizontalAlignment="Stretch" Stretch="UniformToFill" />
        <TextBlock Grid.Row="0" Text="{Binding AccessKeyName, StringFormat=Access Required | {0}}" FontSize="14" Margin="10 0 0 0" Width="320" FontWeight="DemiBold" Foreground="Beige"></TextBlock>
        <Border Grid.Row="2" Margin="10 0 10 10">
            <StackPanel Orientation="Horizontal" Margin="0 5 15 0">
                <Label Content="File:" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14"/>
                <TextBox x:Name="txtSecurityFile" Text="{Binding FilePath, Mode=TwoWay}" HorizontalAlignment="Left" Height="23" Margin="5 0 0 0" VerticalAlignment="Center" Width="166" />
                <Button Content="Browse..." Width="90" Command="{Binding BrowseCommand}" Margin="10 0 0 0"></Button>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="3" Margin="-20 0 0 5" Text="Tip: file can be droped into the current window" Width="250" TextWrapping="Wrap" FontSize="14"></TextBlock>
        <Grid Grid.Row="4" HorizontalAlignment="Stretch" Margin="5 0 5 5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <validation:ValidationMessage Grid.Column="0"  Error="{Binding DataContext.ValidationSummaryError, ElementName=LayoutRoot}" HorizontalAlignment="Left" Width="130" Margin="10 0 0 0"/>
            <Button Content="OK"  Grid.Column="1" Command="{Binding OkCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="75" Height="22" Margin="5"/>
            <Button Content="Cancel" Grid.Column="2" Command="{Binding CancelCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="75" Height="22" Margin="5"/>
        </Grid>

    </Grid>
</decryptionDataProviders:SecurityFileDecryptionDataProviderBase>
