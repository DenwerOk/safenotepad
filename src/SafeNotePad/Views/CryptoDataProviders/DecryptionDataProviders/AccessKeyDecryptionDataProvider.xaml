<decryptionDataProviders:AccessKeyDecryptionDataProviderBase x:Class="SafeNotePad.Views.CryptoDataProviders.DecryptionDataProviders.AccessKeyDecryptionDataProvider"
                            x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:decryptionDataProviders="clr-namespace:SafeNotePad.Views.CryptoDataProviders.DecryptionDataProviders"
        xmlns:validation="clr-namespace:SafeNotePad.Views.Validation"
        xmlns:password="clr-namespace:SafeNotePad.Views.Password"
        Title="Authorize with Password" SizeToContent="WidthAndHeight" Background="Beige" Icon="..\..\Images\lock-8-32.png">
    <Grid Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Image Grid.Row="1" Source="../../Images/access.png" Height="24" Width="340" Stretch="UniformToFill" />
        <TextBlock Grid.Row="1" Text="{Binding AccessKeyName, StringFormat=Access Required | {0}}" FontSize="14" Margin="10 0 0 0" Width="320" FontWeight="DemiBold" Foreground="Beige"></TextBlock>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="15 25 30 10">
            <Label Content="Password:" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14"/>
            <password:BindablePasswordBox Password="{Binding AccessKey, ValidatesOnDataErrors=True}" x:Name="txtPassword" Margin="5 0 0 0" HorizontalAlignment="Left" Height="23" VerticalAlignment="Center" Width="220" />
        </StackPanel>
        <Grid Grid.Row="3" Margin="5 0 5 15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="85"/>
            </Grid.ColumnDefinitions>
            <validation:ValidationMessage Grid.Column="0" HorizontalAlignment="Left" Error="{Binding DataContext.ValidationSummaryError, ElementName=LayoutRoot}" Margin="10 0 0 0" Width="140" />
            <Button Content="OK" Grid.Column="1" Command="{Binding OkCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Height="22"/>
            <Button Content="Cancel" Grid.Column="2" Command="{Binding CancelCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Height="22" />
        </Grid>

    </Grid>
</decryptionDataProviders:AccessKeyDecryptionDataProviderBase>
