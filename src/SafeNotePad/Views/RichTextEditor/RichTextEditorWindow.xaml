<richTextEditor:RichTextEditorWindowBase x:Class="SafeNotePad.Views.RichTextEditor.RichTextEditorWindow"
                                         x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:richTextEditor="clr-namespace:SafeNotePad.Views.RichTextEditor"
        xmlns:controls="clr-namespace:WpfRichText.Ex.Controls"
        Title="{Binding Caption}" SizeToContent="WidthAndHeight" Icon="..\Images\008-doc_edit.png">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static richTextEditor:RichTextEditorWindow.MyCommand}" Executed="MyCommandExecuted"/>
    </Window.CommandBindings>
    <Grid Width="592">
        <Grid.Resources>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="240"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <controls:RichTextEditor Grid.Row="0" x:Name="Editor" Text="{Binding Text, Mode=TwoWay}" VerticalAlignment="Stretch" />
        <Grid Background="#EEF5FD" Grid.Row="1" Visibility="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Press Ctrl-S to Save" Margin="20 17 0 0"></TextBlock>
            <Button Content="OK" Width="75" Height="25" Command="{Binding OkCommand}" HorizontalAlignment="Right" Margin="0 0 120 0"/>
            <Button Content="Cancel" Width="75" Height="25" Command="{Binding CloseCommand}" HorizontalAlignment="Right" Margin="0 0 22 0"/>
        </Grid>

        <Grid Background="#EEF5FD" Grid.Row="1" Visibility="{Binding IsExistent, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Press Ctrl-S to Save" Margin="20 17 0 0"></TextBlock>
            <Button Content="Save" Width="75" Height="25" Command="{Binding OkCommand}" HorizontalAlignment="Right" Margin="0 0 120 0"/>
            <Button Content="Close" Width="75" Height="25" Command="{Binding CloseCommand}" HorizontalAlignment="Right" Margin="0 0 22 0"/>
        </Grid>
    </Grid>
</richTextEditor:RichTextEditorWindowBase>
