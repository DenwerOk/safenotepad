<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="NoteEntity">
    <xs:complexType>
      <xs:sequence>
        <xs:element type="xs:string" name="KeyEncrypted"/>
        <xs:element type="xs:string" name="ValueEncrypted"/>
        <xs:element name="AccessKeyEntity">
          <xs:complexType>
            <xs:sequence>
              <xs:element type="xs:string" name="Tip"/>
              <xs:element type="xs:string" name="PublicKey"/>
              <xs:element type="xs:string" name="PrivateKeyEncrypted"/>
              <xs:element type="xs:int" name="EncryptionTypeID"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>