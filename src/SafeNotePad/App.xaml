<Application x:Class="SafeNotePad.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:validation="clr-namespace:SafeNotePad.Views.Validation"
             xmlns:converters="clr-namespace:SafeNotePad.Views.Converters"
             xmlns:controls="clr-namespace:SafeNotePad.Views.Controls"
             xmlns:password="clr-namespace:SafeNotePad.Views.Password"
             xmlns:grayscaleEffect="clr-namespace:GrayscaleEffect">
    <Application.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"></converters:BooleanToVisibilityConverter>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />

        <Style TargetType="controls:ImageButton" x:Key="MainWindowImageButtonStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:ImageButton">
                        <Grid Name="Grid">
                            <Border Name="Border" CornerRadius="0" Background="{TemplateBinding Background}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="4">
                                <Image Source="{TemplateBinding Image}" Name="Image" VerticalAlignment="Center"  Width="22" Height="23"></Image>
                                <TextBlock Name="TextBlock" FontSize="15" Text="{TemplateBinding Content}" VerticalAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="14" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="4 0 4 0" ></TextBlock>
                            </StackPanel>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="LightGray" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="1" />
                                <Setter TargetName="Grid" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush
                                    StartPoint="0,0"
                                    EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="#F2F2F2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="LightGray" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="1" />
                                <Setter TargetName="Grid" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush
                                    StartPoint="0,0"
                                    EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="White" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Image" Property="Effect">
                                    <Setter.Value>
                                        <grayscaleEffect:GrayscaleEffect DesaturationFactor="0"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Image" Property="Opacity" Value="0.7"></Setter>
                                <Setter TargetName="TextBlock" Property="Foreground" Value="Gray"></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent"></Setter>
            <Setter Property="BorderThickness" Value="0" ></Setter>
            <Setter Property="VerticalAlignment" Value="Center" ></Setter>
        </Style>
        <Style TargetType="controls:ImageButton" x:Key="AccessKeyImageButtonStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:ImageButton">
                        <Grid Name="Grid">
                            <Border Name="Border" CornerRadius="3" Background="{TemplateBinding Background}" />
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="3 5 3 3">
                                <Image Source="{TemplateBinding Image}" Name="Image"  Width="40" Height="30"></Image>
                                <TextBlock Name="TextBlock" Text="{TemplateBinding Content}" LineStackingStrategy="BlockLineHeight" LineHeight="14" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="4" ></TextBlock>
                            </StackPanel>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="LightGray" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="1" />
                                <Setter TargetName="Grid" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush
                                    StartPoint="0,0"
                                    EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="#F2F2F2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="LightGray" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="1" />
                                <Setter TargetName="Grid" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush
                                    StartPoint="0,0"
                                    EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="White" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Image" Property="Effect">
                                    <Setter.Value>
                                        <grayscaleEffect:GrayscaleEffect DesaturationFactor="0"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Image" Property="Opacity" Value="0.7"></Setter>
                                <Setter TargetName="TextBlock" Property="Foreground" Value="Gray"></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent"></Setter>
            <Setter Property="BorderThickness" Value="0" ></Setter>
            <Setter Property="VerticalAlignment" Value="Center" ></Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="BorderBrush" Value="#99A6C2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush
                            StartPoint="0,0"
                            EndPoint="0,1">
                        <GradientStop Color="#EEEFF7" Offset="0"/>
                        <GradientStop Color="#C8CFE1" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <DockPanel LastChildFill="True" >
                            <!-- Wrap this in a Grid so that the height of the warning is stretched to match the height of the adorned control. -->
                            <Grid DockPanel.Dock="Right" Panel.ZIndex="9999" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Image Source="Views\Images\error.png" Margin="5 0 0 0" Height="20" Width="25" ToolTipService.InitialShowDelay="0">
                                    <Image.ToolTip>
                                        <ToolTip  Content="{Binding Path=/ErrorContent}" />
                                    </Image.ToolTip>
                                </Image>
                            </Grid>

                            <!-- Draw a border around the control -->
                            <Border x:Name="brdErrorIndicator" BorderBrush="Red" BorderThickness="1">
                                <AdornedElementPlaceholder Name="Control_AdornedElementPlaceholder" Margin="-1 -1 -1 -1"/>
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <DockPanel LastChildFill="True" >
                            <!-- Wrap this in a Grid so that the height of the warning is stretched to match the height of the adorned control. -->
                            <Grid DockPanel.Dock="Right" Panel.ZIndex="9999" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Image Source="Views\Images\error.png" Margin="5 0 0 0" Height="20" Width="25" ToolTipService.InitialShowDelay="0">
                                    <Image.ToolTip>
                                        <ToolTip  Content="{Binding Path=/ErrorContent}" />
                                    </Image.ToolTip>
                                </Image>
                            </Grid>

                            <!-- Draw a border around the control -->
                            <Border x:Name="brdErrorIndicator" BorderBrush="Red" BorderThickness="1">
                                <AdornedElementPlaceholder Name="Control_AdornedElementPlaceholder" Margin="-1 -1 -1 -1"/>
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                    </Setter.Value>
            </Setter>
            </Style>
            <Style TargetType="{x:Type password:BindablePasswordBox}">
                <Setter Property="Validation.ErrorTemplate">
                    <Setter.Value>
                        <ControlTemplate>
                            <DockPanel LastChildFill="True" >
                                <!-- Wrap this in a Grid so that the height of the warning is stretched to match the height of the adorned control. -->
                                <Grid DockPanel.Dock="Right" Panel.ZIndex="9999" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Image Source="Views\Images\error.png" Margin="5 0 0 0" Height="20" Width="25" ToolTipService.InitialShowDelay="0">
                                        <Image.ToolTip>
                                            <ToolTip  Content="{Binding Path=/ErrorContent}" />
                                        </Image.ToolTip>
                                    </Image>
                                </Grid>

                            <!-- Draw a border around the control -->
                            <Border x:Name="brdErrorIndicator" BorderBrush="Red" BorderThickness="1">
                                <AdornedElementPlaceholder Name="Control_AdornedElementPlaceholder" Margin="-1 -1 -1 -1"/>
                            </Border>
                        </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
    </Application.Resources>
</Application>
